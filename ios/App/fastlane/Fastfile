# frozen_string_literal: true

require "base64"

# Runs on GitHub's macOS CI runner, never locally — there's no macOS machine
# in this project's normal workflow.
#
# SIGNING APPROACH: explicit, manual, no guessing.
#
# The obvious route is automatic signing plus xcodebuild
# -allowProvisioningUpdates, and it does not work headlessly here. Automatic
# signing kept resolving to an "iOS App Development" profile, which requires
# registered device UDIDs that a CI runner will never have. Forcing the
# identity to "Apple Distribution" instead just trades that for "conflicting
# provisioning settings", because Xcode reads any explicit identity as MANUAL
# signing while the target still says automatic. There is no value that
# satisfies both.
#
# So: create the distribution certificate and an App Store provisioning
# profile up front via the API key (cert + sigh, no `match` repo needed),
# switch the App target to manual signing, and hand the profile to gym by
# name. Nothing is left for Xcode to infer.
default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # A GitHub secret that's missing or was saved empty doesn't fail the
    # workflow — it just interpolates as "" and produces a misleading Xcode
    # error several steps later. Check up front and name the one at fault.
    required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT ASC_TEAM_ID ASC_BUNDLE_ID]
    missing = required.select { |k| ENV[k].to_s.strip.empty? }
    unless missing.empty?
      UI.user_error!(
        "Missing or empty GitHub secret(s): #{missing.join(', ')}. " \
        "Check Settings -> Secrets and variables -> Actions on the repo.",
      )
    end
    unless Base64.decode64(ENV["ASC_KEY_CONTENT"]).include?("PRIVATE KEY")
      UI.user_error!(
        "ASC_KEY_CONTENT did not decode to a valid .p8 private key. " \
        "It must be the base64 of the whole AuthKey_XXXX.p8 file.",
      )
    end

    # Creates a temporary keychain and unlocks it. Without this the signing
    # certificate has nowhere to be installed on a fresh runner.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
    )

    # Distribution certificate — reused if the team already has a valid one.
    cert(
      api_key: api_key,
      development: false,
      team_id: ENV["ASC_TEAM_ID"],
    )

    # App Store provisioning profile. Unlike a development profile this needs
    # no registered devices, which is the whole point.
    sigh(
      api_key: api_key,
      app_identifier: ENV["ASC_BUNDLE_ID"],
      team_id: ENV["ASC_TEAM_ID"],
      development: false,
      force: false,
    )

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["ASC_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      bundle_identifier: ENV["ASC_BUNDLE_ID"],
      targets: ["App"],
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV["ASC_BUNDLE_ID"] => lane_context[SharedValues::SIGH_NAME],
        },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
