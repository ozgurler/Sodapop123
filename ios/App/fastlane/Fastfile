# frozen_string_literal: true

# Runs on GitHub's macOS CI runner, never locally — there's no macOS machine
# in this project's normal workflow. `xcodebuild -allowProvisioningUpdates`
# with an App Store Connect API key creates and refreshes the signing
# certificate and provisioning profile itself; no `match`, no manually
# exported .p12, nothing to keep in sync by hand.
default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # A GitHub secret that's missing or was saved empty doesn't fail the
    # workflow — it just interpolates as "" and produces a misleading Xcode
    # error three steps later (this happened: an empty ASC_TEAM_ID showed up
    # as "Signing requires a development team", not as anything mentioning
    # the secret itself). Check up front and name the exact secret at fault.
    required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT ASC_TEAM_ID ASC_BUNDLE_ID]
    missing = required.select { |k| ENV[k].to_s.strip.empty? }
    unless missing.empty?
      UI.user_error!(
        "Missing or empty GitHub secret(s): #{missing.join(', ')}. " \
        "Check Settings -> Secrets and variables -> Actions on the repo.",
      )
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    # Bump the build number to the CI run number so every TestFlight upload
    # is unique without hand-editing a counter in Xcode.
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      # DEVELOPMENT_TEAM is blank in the generated Xcode project — Capacitor
      # has no way to know it at project-generation time, and team_id() in
      # the Appfile only scopes Fastlane's own API calls, not the xcodebuild
      # archive step itself.
      #
      # -allowProvisioningUpdates on its own isn't enough either: with no
      # Apple ID signed into Xcode's Accounts pane (there never will be one
      # on a CI runner), it fails with "No Accounts" / "No profiles found".
      # It needs the SAME API key handed to it explicitly via
      # -authenticationKey* flags so it can create the certificate and
      # profile itself, the same way app_store_connect_api_key authenticates
      # Fastlane's own API calls above.
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath '#{api_key[:key_filepath]}'",
        "-authenticationKeyID #{api_key[:key_id]}",
        "-authenticationKeyIssuerID #{api_key[:issuer_id]}",
        "DEVELOPMENT_TEAM=#{ENV['ASC_TEAM_ID']}",
      ].join(" "),
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
