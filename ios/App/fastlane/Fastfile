# frozen_string_literal: true

require "base64"

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT ASC_TEAM_ID ASC_BUNDLE_ID]
    missing = required.select { |k| ENV[k].to_s.strip.empty? }
    unless missing.empty?
      UI.user_error!(
        "Missing or empty GitHub secret(s): #{missing.join(', ')}. " \
        "Check Settings -> Secrets and variables -> Actions on the repo.",
      )
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    key_path = File.expand_path("~/.appstoreconnect_key.p8")
    File.write(key_path, Base64.decode64(ENV["ASC_KEY_CONTENT"]))
    unless File.read(key_path).include?("PRIVATE KEY")
      UI.user_error!(
        "ASC_KEY_CONTENT did not decode to a valid .p8 private key. " \
        "It must be the base64 of the whole AuthKey_XXXX.p8 file.",
      )
    end

    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath '#{key_path}'",
        "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
        "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
        "DEVELOPMENT_TEAM=#{ENV['ASC_TEAM_ID']}",
      ].join(" "),
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end