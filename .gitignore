*.p12
*.mobileprovision
*.keystore
*.jks

# Fastlane run artifacts — regenerated every CI run, never hand-edited.
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/screenshots/
ios/fastlane/test_output/
*.ipa
*.dSYM.zip
